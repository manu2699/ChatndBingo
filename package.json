{
	"name": "chatndbingo",
	"version": "2.0.0",
	"private": true,
	"description": "Chat and play Bingo with your friends",
	"author": "Maneesh K",
	"license": "ISC",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:server": "bun --watch apps/server/src/index.ts",
		"dev:web": "bun --cwd apps/web run dev",
		"build": "bun --cwd apps/web run build",
		"start": "bun apps/server/src/index.ts",
		"typecheck": "tsc -b",
		"test": "bun test"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.9.0"
	}
}
