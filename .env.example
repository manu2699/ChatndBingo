# All optional. Defaults suit local development.
PORT=10000
# Omit REDIS_URL to keep rooms in memory (lost on restart).
# REDIS_URL=redis://localhost:6379
# Extra origins allowed to open a WebSocket (same-origin and localhost are always allowed).
# ALLOWED_ORIGINS=https://my-frontend.example.com
# ROOM_TTL_SECONDS=7200
# MAX_ROOMS=500
# MAX_CONNECTIONS=1000
